# Client: no credentials required for offline use.
MYCMD_API_URL=https://api.example.invalid
MYCMD_SYNC_ENABLED=false
# Empty means platform default (implementation in later phases).
MYCMD_DATA_DIR=
MYCMD_DEFAULT_SHELL=
# Server only. Never distribute these to clients or public bundles.
DATABASE_URL=
MYCMD_SECRET_KEY=
MYCMD_PUBLIC_ORIGIN=
MYCMD_BOOTSTRAP_TOKEN=
MYCMD_ACCESS_TOKEN_MINUTES=15
MYCMD_REFRESH_TOKEN_DAYS=30
MYCMD_ENVIRONMENT=development
# Production only: public origin(s) must be origin-only HTTPS URLs.
